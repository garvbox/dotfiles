#!/bin/sh
# Thread ledger capture; no args opens the ledger.
# `park sweep` archives checked-off lines to THREADS-archive.md.
# `park resume` picks an open line tagged claude:<id> and resumes that session.
# Inside Claude Code (`! park ...`) the line is tagged with the session id.
LEDGER="$HOME/projects/kv-workspace/THREADS.md"
ARCHIVE="$HOME/projects/kv-workspace/THREADS-archive.md"

if [ $# -eq 0 ]; then
    exec nvim + "$LEDGER"
fi

if [ "$1" = "sweep" ]; then
    n=$(grep -c '^- \[[xX]\]' "$LEDGER") || exit 0
    [ -f "$ARCHIVE" ] || printf '# Thread Ledger Archive\n\n' >"$ARCHIVE"
    grep '^- \[[xX]\]' "$LEDGER" >>"$ARCHIVE"
    tmp=$(mktemp)
    grep -v '^- \[[xX]\]' "$LEDGER" >"$tmp"
    mv "$tmp" "$LEDGER"
    echo "archived $n"
    exit 0
fi

if [ "$1" = "resume" ]; then
    tagged=$(grep '^- \[ \].*· claude:' "$LEDGER")
    if [ -z "$tagged" ]; then
        echo "park: no open lines tagged claude:<id> (park with \`! park\` inside Claude)" >&2
        exit 1
    fi
    line=$(printf '%s\n' "$tagged" | fzf --tac --prompt 'resume> ') || exit 0
    short=$(printf %s "$line" | sed -n 's/.*· claude:\([0-9a-f]\{8\}\).*/\1/p')
    file=$(ls "$HOME"/.claude/projects/*/"$short"*.jsonl 2>/dev/null | head -1)
    if [ -z "$file" ]; then
        echo "no transcript for claude:$short (expired?); ticket or delete the line" >&2
        exit 1
    fi
    id=$(basename "$file" .jsonl)
    dir=$(grep -m1 -o '"cwd":"[^"]*"' "$file" | sed 's/^"cwd":"//; s/"$//')
    [ -d "$dir" ] || dir=$HOME
    if [ -n "${TMUX:-}" ]; then
        exec tmux new-window -c "$dir" -n "resume:$short" "claude --resume $id"
    fi
    cd "$dir" && exec claude --resume "$id"
fi

ctx=$(date "+%Y-%m-%d %H:%M")
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    repo=$(basename "$(git rev-parse --show-toplevel)")
    branch=$(git branch --show-current)
    ctx="$ctx · $repo@$branch"
fi
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
    ctx="$ctx · claude:$(printf %s "$CLAUDE_CODE_SESSION_ID" | cut -c1-8)"
fi

printf -- '- [ ] %s — %s\n' "$ctx" "$*" >>"$LEDGER"
