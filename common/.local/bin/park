#!/bin/sh
# Thread ledger capture; no args opens the ledger.
# `park sweep` archives checked-off lines to THREADS-archive.md.
LEDGER="$HOME/projects/kv-workspace/THREADS.md"
ARCHIVE="$HOME/projects/kv-workspace/THREADS-archive.md"

if [ $# -eq 0 ]; then
    exec nvim + "$LEDGER"
fi

if [ "$1" = "sweep" ]; then
    n=$(grep -c '^- \[[xX]\]' "$LEDGER") || exit 0
    [ -f "$ARCHIVE" ] || printf '# Thread Ledger Archive\n\n' >"$ARCHIVE"
    grep '^- \[[xX]\]' "$LEDGER" >>"$ARCHIVE"
    tmp=$(mktemp)
    grep -v '^- \[[xX]\]' "$LEDGER" >"$tmp"
    mv "$tmp" "$LEDGER"
    echo "archived $n"
    exit 0
fi

ctx=$(date "+%Y-%m-%d %H:%M")
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    repo=$(basename "$(git rev-parse --show-toplevel)")
    branch=$(git branch --show-current)
    ctx="$ctx · $repo@$branch"
fi

printf -- '- [ ] %s — %s\n' "$ctx" "$*" >>"$LEDGER"
